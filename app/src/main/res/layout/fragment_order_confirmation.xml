<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:app="http://schemas.android.com/apk/res-auto"
             android:layout_width="match_parent"
             android:layout_height="match_parent">

    <ScrollView
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F5F5F5">

        <LinearLayout
                android:id="@+id/baseLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

            <!-- Sélection d'adresse sauvegardée -->
            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="16dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/saved_addresses_text"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:layout_marginBottom="8dp"
                            android:textColor="@android:color/black"/>

                    <!-- FrameLayout pour contenir à la fois le dropdown et la progressbar -->
                    <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                        <!-- Spinner pour sélectionner une adresse -->
                        <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/addressDropdownLayout"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/choose_address">

                            <AutoCompleteTextView
                                    android:id="@+id/addressDropdown"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- ProgressBar qui s'affiche pendant le chargement des adresses -->
                        <ProgressBar
                                android:id="@+id/addressLoadingProgressBar"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_gravity="center"
                                android:indeterminate="true"
                                android:visibility="gone"/>
                    </FrameLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Adresse de Livraison (avec option pour replier) -->
            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardShippingAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="16dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <!-- Header avec titre et bouton pour replier -->
                    <LinearLayout
                            android:id="@+id/headerShippingAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/delivery_address"
                                android:textStyle="bold"
                                android:textSize="18sp"
                                android:textColor="@android:color/black"/>

                        <ImageView
                                android:id="@+id/imgExpandCollapse"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_expand_less"
                                android:contentDescription="@string/fold_unfold"/>
                    </LinearLayout>

                    <!-- Container pour les champs d'adresse (repliable) -->
                    <LinearLayout
                            android:id="@+id/containerAddressFields"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:paddingTop="0dp">

                        <!-- Adresse -->
                        <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editTextStreet"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/address_and_number"
                                    android:inputType="text"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Appartement (optionnel) -->
                        <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editTextApartment"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/apartment_optional"
                                    android:inputType="text"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Ville -->
                        <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editTextCity"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/city_text"
                                    android:inputType="text"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Pays -->
                        <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editTextCountry"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/country_text"
                                    android:inputType="text"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Code Postal -->
                        <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editTextPostalCode"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/postal_code_text"
                                    android:inputType="number"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Options de livraison en cas d'absence -->
            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="16dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/in_case_of_absence_text"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:layout_marginBottom="8dp"
                            android:textColor="@android:color/black"/>

                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/where_to_leave_package_text"
                            android:textSize="14sp"
                            android:layout_marginBottom="12dp" />

                    <!-- Options de dépôt -->
                    <RadioGroup
                            android:id="@+id/radioGroupDeliveryOptions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/radioButtonGarden"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/option_garden"
                                android:padding="8dp" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/radioButtonCarport"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/option_carport"
                                android:padding="8dp" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/radioButtonNeighbor"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/option_neighbor"
                                android:padding="8dp" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/radioButtonBackDoor"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/option_back_door"
                                android:padding="8dp" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/radioButtonOther"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/other_text"
                                android:padding="8dp" />
                    </RadioGroup>

                    <!-- Champ pour spécifier "Autre" -->
                    <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/otherDeliveryOptionLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editTextOtherOption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/specify_where_to_leave_package_text"
                                android:inputType="text"
                                android:maxLength="50" />

                        <TextView
                                android:id="@+id/textViewCharCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:text="@string/zero_out_of_fifty"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bouton de Validation -->
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmOrder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/proceed_to_payment"
                    android:padding="16dp"
                    app:cornerRadius="12dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- ProgressBar stylisée par-dessus (inchangé) -->
    <androidx.cardview.widget.CardView
            android:id="@+id/loadingCard"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:elevation="8dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

            <ProgressBar
                    android:id="@+id/ordersLoadingProgressBar"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/accent_color" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/loading"
                    android:textColor="@color/primary_text_color"
                    android:textSize="12sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>