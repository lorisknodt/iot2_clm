<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/mobile_navigation"
            app:startDestination="@+id/nav_products">

    <fragment
            android:id="@+id/nav_products"
            android:name="com.example.clm_iot2.ui.products.ProductsFragment"
            android:label="@string/menu_products"
            tools:layout="@layout/fragment_products">

            <action
                android:id="@+id/action_productsFragment_to_singleProductFragment"
                app:destination="@id/singleProductFragment" />

    </fragment>

    <fragment
            android:id="@+id/singleProductFragment"
            android:name="com.example.clm_iot2.ui.singleproduct.SingleProductFragment"
            android:label="@string/menu_product_detail" />


    <fragment
            android:id="@+id/nav_cart"
            android:name="com.example.clm_iot2.ui.cart.CartFragment"
            android:label="@string/menu_cart">
        <action
                android:id="@+id/action_cartFragment_to_singleProductFragment"
                app:destination="@id/singleProductFragment"/>

        <action
                android:id="@+id/action_cartFragment_to_orderConfirmationFragment"
                app:destination="@id/orderConfirmationFragment" />

    </fragment>

    <fragment
            android:id="@+id/nav_orders"
            android:name="com.example.clm_iot2.ui.orders.OrdersFragment"
            android:label="@string/menu_orders"
            tools:layout="@layout/fragment_orders">
        <action
            android:id="@+id/action_orderFragment_to_singleOrderFragment"
            app:destination="@+id/nav_singleorder" />

        <action
            android:id="@+id/action_orderFragment_to_productsFragment"
            app:destination="@+id/nav_products" />

    </fragment>

    <fragment
            android:id="@+id/nav_singleorder"
            android:name="com.example.clm_iot2.ui.singleorder.SingleOrderFragment"
            android:label="@string/menu_order_detail"/>


    <fragment
            android:id="@+id/nav_profile"
            android:name="com.example.clm_iot2.ui.profile.ProfileFragment"
            android:label="@string/menu_profile"
            tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_orderFragment"
            app:destination="@id/nav_orders"/>

        <action
            android:id="@+id/action_profileFragment_to_developmentFragment"
            app:destination="@id/nav_development"/>

    </fragment>

    <fragment
            android:id="@+id/nav_development"
            android:name="com.example.clm_iot2.ui.development.DevelopmentFragment"
            android:label="@string/menu_tracking"
            tools:layout="@layout/fragment_in_development"/>

    <fragment
            android:id="@+id/orderConfirmationFragment"
            android:name="com.example.clm_iot2.ui.orderConfirmation.OrderConfirmationFragment"
            android:label="@string/menu_order_confirmation">
        <action
                android:id="@+id/action_orderConfirmation_to_paymentFragment"
                app:destination="@id/paymentFragment"/>

    </fragment>

    <fragment
            android:id="@+id/paymentFragment"
            android:name="com.example.clm_iot2.ui.payment.PaymentFragment"
            android:label="@string/menu_order_confirmation">
        <action
                android:id="@+id/action_paymentFragment_to_paymentSuccessFragment"
                app:destination="@id/paymentSuccessFragment" />

        <action
                android:id="@+id/action_paymentFragment_to_paymentFailedFragment"
                app:destination="@id/paymentFailedFragment" />

    </fragment>

    <fragment
            android:id="@+id/paymentSuccessFragment"
            android:name="com.example.clm_iot2.ui.payment.PaymentSuccessFragment"
            android:label="@string/menu_order_confirmation" />

    <fragment
            android:id="@+id/paymentFailedFragment"
            android:name="com.example.clm_iot2.ui.payment.PaymentFailedFragment"
            android:label="@string/menu_order_confirmation" />




</navigation>